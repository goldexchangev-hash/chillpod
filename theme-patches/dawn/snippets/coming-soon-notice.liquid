{% comment %}
  COPY INTO SHOPIFY: Online Store -> Themes -> (duplicate of live theme) -> Edit code
  -> Snippets -> Add a new snippet -> name it "coming-soon-notice" -> paste this file.

  Renders the "Coming Soon" block that replaces Add to cart / Buy Now / accelerated
  checkout while the theme setting `settings.coming_soon_mode` is on.

  This snippet is MESSAGING ONLY. It does not stop /cart/add, cart permalinks or
  Shop Pay deep links. The hard stop is product inventory = 0 in Shopify Admin
  (see docs/COMING_SOON_DISABLE_ORDERS.md, Layer 1).

  Accepts:
  - layout: {String} 'block' (default) full-width button + supporting lines, for the PDP
                     'inline' a single pill, for header / sticky bar / homepage CTAs
  - href:   {String} optional. When given with layout 'inline', renders an <a> to that URL
                     (informational only, e.g. '/products/chillpod'). Never pass a /cart or
                     /checkout URL here.
  - show_note: {Boolean} show the optional note line under the supporting line. Default: true

  Usage:
  {% render 'coming-soon-notice' %}
  {% render 'coming-soon-notice', layout: 'inline', href: product.url %}
{% endcomment %}

{%- liquid
  assign cs_label = settings.coming_soon_label | default: 'Coming Soon'
  assign cs_sub = settings.coming_soon_subline | default: 'Availability coming soon'
  assign cs_note = settings.coming_soon_note
  assign cs_layout = layout | default: 'block'
  if show_note == nil
    assign show_note = true
  endif
-%}

{% style %}
  .coming-soon {
    display: block;
  }
  .coming-soon__button {
    cursor: default;
    pointer-events: none;
    opacity: 0.9;
  }
  .coming-soon--block .coming-soon__button {
    margin-bottom: 1rem;
  }
  .coming-soon__sub {
    margin: 0 0 0.4rem;
    font-weight: 600;
  }
  .coming-soon__note {
    margin: 0;
    opacity: 0.75;
  }
  .coming-soon--inline {
    display: inline-block;
  }
  .coming-soon--inline .coming-soon__button {
    pointer-events: auto;
    cursor: default;
    text-decoration: none;
  }
{% endstyle %}

{%- if cs_layout == 'inline' -%}
  {%- if href != blank -%}
    <a
      class="coming-soon coming-soon--inline coming-soon__button button button--secondary"
      href="{{ href }}"
      aria-label="{{ cs_label | escape }} - {{ cs_sub | escape }}"
    >
      {{ cs_label | escape }}
    </a>
  {%- else -%}
    <span
      class="coming-soon coming-soon--inline coming-soon__button button button--secondary"
      role="status"
      aria-disabled="true"
      aria-label="{{ cs_label | escape }} - {{ cs_sub | escape }}"
    >
      {{ cs_label | escape }}
    </span>
  {%- endif -%}
{%- else -%}
  <div class="coming-soon coming-soon--block" role="status" aria-live="polite">
    <span class="coming-soon__button button button--full-width button--secondary" aria-disabled="true">
      {{ cs_label | escape }}
    </span>
    <p class="coming-soon__sub">{{ cs_sub | escape }}</p>
    {%- if show_note and cs_note != blank -%}
      <p class="coming-soon__note">{{ cs_note | escape }}</p>
    {%- endif -%}
  </div>
{%- endif -%}
